+        cabinet = make_cabinet(load_cases=source)
+        source.append("MUTATED")
+        self.assertEqual(("DEAD_LOAD", "POINT_LOAD"), cabinet.load_cases)
+
+        for value in (
+            (),
+            [],
+            "DEAD_LOAD",
+            ("DEAD_LOAD", "DEAD_LOAD"),
+            ("",),
+            ("  ",),
+            (None,),
