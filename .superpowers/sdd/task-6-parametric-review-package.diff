+            and self.width_min_mm
+            <= cabinet.width_mm
+            <= self.width_max_mm
+            and self.depth_min_mm
+            <= cabinet.depth_mm
+            <= self.depth_max_mm
+            and self.height_min_mm
+            <= cabinet.height_mm
+            <= self.height_max_mm
