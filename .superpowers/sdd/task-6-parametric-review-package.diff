+def make_envelope(**overrides: object) -> QualificationEnvelope:
+    arguments: dict[str, object] = {
+        "envelope_id": ENVELOPE_ID,
+        "connector_sku_id": CONNECTOR_SKU_ID,
+        "panel_a": make_constraint(),
+        "panel_b": make_constraint(
