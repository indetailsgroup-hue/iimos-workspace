+        {
+            "group_count": len(required_groups),
+            "missing": missing,
+            "implementation_report_topology": report_topology,
+        },
+    )
+
+    html_paths = sorted(
+        {
+            ROOT / path
+            for group in required_groups
+            for path in group
+            if path.endswith(".html")
