+        "th_tables": len(re.findall(r"^\| ---", th_report, re.MULTILINE)),
+        "en_links": len(re.findall(r"\]\(https://", en_report)),
+        "th_links": len(re.findall(r"\]\(https://", th_report)),
+    }
+    evidence.add(
+        "gap_report_parity",
+        topology
+        == {
+            "en_h2": 14,
+            "th_h2": 14,
+            "en_h3": 22,
+            "th_h3": 22,
