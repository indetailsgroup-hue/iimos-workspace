+class CliContractTests(unittest.TestCase):
+    def run_cli(
+        self,
+        *arguments: object,
+        cwd: Path | None = None,
+    ) -> subprocess.CompletedProcess[str]:
+        script = (
+            REPOSITORY_ROOT
+            / "tools"
+            / "connector_registry"
+            / "ingest_reviewed.py"
+        )
+        return subprocess.run(
+            [sys.executable, "-B", str(script), *(str(item) for item in arguments)],
+            cwd=cwd or REPOSITORY_ROOT,
+            capture_output=True,
+            text=True,
+            check=False,
+        )
+
+    @staticmethod
+    def write_jsonl(path: Path, records: list[object]) -> None:
+        path.write_text(
+            "".join(
+                json.dumps(record, sort_keys=True, separators=(",", ":")) + "\n"
+                for record in records
+            ),
+            encoding="utf-8",
+        )
+
+    @staticmethod
+    def candidate_payload(
+        *,
+        candidate_id: str,
+        assertion_id: str,
+        source_id: str,
+        extraction_method: str = "HUMAN_REVIEWED",
+        brand_id: str = BRAND_ID,
+        field_path: str = "identity.exact_sku",
+        value: object | None = None,
+    ) -> dict[str, object]:
+        return {
+            "candidate_id": candidate_id,
+            "brand_id": brand_id,
+            "entity_kind": "CONNECTOR_ASSEMBLY",
+            "extraction_method": extraction_method,
+            "assertions": [
+                {
+                    "assertion_id": assertion_id,
+                    "entity_id": candidate_id,
+                    "field_path": field_path,
+                    "value": (
+                        candidate_id.rsplit(":", 1)[-1].upper()
+                        if value is None
+                        else value
+                    ),
+                    "source_id": source_id,
+                    "locator": "page 1",
+                    "reviewer": "reviewer:registry",
+                    "review_state": "VERIFIED",
+                }
+            ],
+        }
