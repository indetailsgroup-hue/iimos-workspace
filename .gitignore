# Python
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
.venv/
dist/
build/
*.egg-info/

# Local secrets and credentials
.env
.env.*
!.env.example
*.pem
*.key

# superpowers brainstorming companion writes a session token here — never
# commit it. The ignore is scoped to that directory rather than to the whole
# of .superpowers/, because the wholesale ignore also hid .superpowers/sdd/,
# which holds the SDD evidence trail: every task brief, implementer report and
# review-package diff whose digests the progress ledger publishes. A ledger
# that cites artifacts a reader cannot open is a ledger a reader cannot check.
.superpowers/brainstorm/

# OS and editor noise
.DS_Store
Thumbs.db
.idea/
.vscode/

# Temporary execution files
*.tmp
*.log

# Repeatable kitchen-kernel verifier output
/artifacts/verification/kitchen-kernel-bootstrap-summary.json
