# ADR-050: vault เก็บเฉพาะความรู้ text — แคตตาล็อก binary ยักษ์อยู่นอก git (2.8GB+)
daph-second-brain/**/*.pdf
daph-second-brain/**/blaetterkatalog*
daph-second-brain/**/Catalogue*
daph-second-brain/**/BIun*
daph-second-brain/**/*.zip

*.patch
ธุระกิจ/

# Environment files — .env.example stays tracked as the template.
# packages/field-app/.env was sitting untracked and would have been swept in by
# `git add -A` (it holds VITE_SUPABASE_URL + ANON_KEY).
.env
.env.local
.env.*
!.env.example
!**/.env.example

# Supabase Studio scratch queries ("Untitled query NNN.sql")
supabase/snippets/

# Local isolated execution lanes
.worktrees/

# Google Drive folder-icon stubs. Drive for desktop drops a hidden+system
# desktop.ini into every folder it syncs, which buries `git status` under
# hundreds of untracked entries. Drive also writes them inside .git/, where
# .gitignore has no effect and they break `git gc` — the cleanup script lives
# in the parent repo at tools/git-drive-cleanup.ps1 and covers this repo too.
desktop.ini
